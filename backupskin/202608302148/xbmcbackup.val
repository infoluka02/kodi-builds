u01b0\u1ee3c \u0111\u1ecbnh c\u1ea5u h\u00ecnh b\u1edfi ng\u01b0\u1eddi d\u00f9ng \u0111\u1ec3 ki\u1ec3m so\u00e1t chi ti\u1ebft; [Kh\u00f4ng] kh\u00f4ng c\u00f3 \u1ea3nh", "id": "musiclibrary.artworklevel", "label": "M\u1ee9c \u0111\u1ed9 \u1ea3nh minh h\u1ecda", "level": "standard", "options": [{"label": "T\u1ed1i \u0111a", "value": 0}, {"label": "C\u01a1 b\u1ea3n", "value": 1}, {"label": "Tu\u1ef3 ch\u1ec9nh", "value": 2}, {"label": "Kh\u00f4ng", "value": 3}], "parent": "", "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "string", "multiselect": true, "type": "list"}, "default": ["folder.jpg", "cover.jpg", "cover.jpeg", "thumb.jpg"], "definition": {"allowempty": true, "allownewoption": true, "control": {"delayed": false, "format": "string", "multiselect": true, "type": "list"}, "default": "folder.jpg, cover.jpg, cover.jpeg, thumb.jpg", "enabled": true, "help": "The names of files that contain primary artwork (thumbnails), generally square and used both full and in reduced size to visually identify a folder, artist, album or song", "id": "musiclibrary.musicthumbs.definition", "label": "T\u1eadp tin h\u00ecnh \u1ea3nh thu nh\u1ecf", "level": "expert", "options": [{"label": "folder.jpg", "value": "folder.jpg"}, {"label": "cover.jpg", "value": "cover.jpg"}, {"label": "cover.jpeg", "value": "cover.jpeg"}, {"label": "thumb.jpg", "value": "thumb.jpg"}], "parent": "", "type": "string", "value": "folder.jpg, cover.jpg, cover.jpeg, thumb.jpg"}, "delimiter": ", ", "elementtype": "string", "enabled": true, "help": "The names of files that contain primary artwork (thumbnails), generally square and used both full and in reduced size to visually identify a folder, artist, album or song", "id": "musiclibrary.musicthumbs", "label": "T\u1eadp tin h\u00ecnh \u1ea3nh thu nh\u1ecf", "level": "expert", "maximumItems": -1, "minimumItems": 0, "parent": "", "type": "list", "value": ["folder.jpg", "cover.jpg", "cover.jpeg", "thumb.jpg"]}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Tr\u01b0\u1eddng h\u1ee3p kh\u00f4ng c\u00f3 \u1ea3nh b\u00eca album n\u1ed9i b\u1ed9 t\u1ed3n t\u1ea1i, \u1ea3nh tr\u1ef1c tuy\u1ebfn s\u1ebd \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng. N\u1ebfu kh\u00f4ng c\u00f3 s\u1eb5n, \u1ea3nh b\u00eca \u0111\u01b0\u1ee3c nh\u00fang trong t\u1eadp tin nh\u1ea1c s\u1ebd \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng", "id": "musiclibrary.preferonlinealbumart", "label": "\u01afu ti\u00ean \u1ea3nh album tr\u1ef1c tuy\u1ebfn", "level": "standard", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "T\u1ef1 \u0111\u1ed9ng \u0111i \u0111\u1ebfn c\u1eeda s\u1ed5 tr\u1ef1c quan khi b\u1eaft \u0111\u1ea7u ph\u00e1t \u00e2m thanh", "id": "musicfiles.selectaction", "label": "Chuy\u1ec3n sang tr\u1ef1c quan khi ph\u00e1t", "level": "basic", "parent": "", "type": "boolean", "value": false}, {"allowempty": false, "allownewoption": false, "control": {"delayed": true, "format": "string", "heading": "C\u00e1c tu\u1ef3 ch\u1ecdn: %A, %T, %N, %B, %D, %G, %Y, %F, %S", "hidden": false, "type": "edit", "verifynewvalue": false}, "default": "[%N. ]%A - %T", "enabled": true, "help": "Ki\u1ec3m so\u00e1t c\u00e1ch hi\u1ec3n th\u1ecb t\u00ean c\u1ee7a c\u00e1c b\u00e0i h\u00e1t trong giao di\u1ec7n ng\u01b0\u1eddi d\u00f9ng. \u0110\u1ec3 ho\u1ea1t \u0111\u1ed9ng \u0111\u00fang, th\u1ebb \u0111\u1ecdc c\u1ea7n \u0111\u01b0\u1ee3c b\u1eadt.", "id": "musicfiles.trackformat", "label": "M\u1eabu \u0111\u1eb7t t\u00ean b\u00e0i h\u00e1t", "level": "expert", "parent": "", "type": "string", "value": "[%N. ]%A - %T"}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Search for thumbs on remote shares and optical media. This can often slow down the listing of network folders.", "id": "musicfiles.findremotethumbs", "label": "T\u00ecm ki\u1ebfm h\u00ecnh thu nh\u1ecf tr\u00ean \u0111i\u1ec1u khi\u1ec3n t\u1eeb xa chia s\u1ebb", "level": "advanced", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "When browsing music files in file view read the tags of those not in the music library as you go. This can make large directories slow to display, especially over a network.", "id": "musicfiles.usetags", "label": "Enable tag reading in file view", "level": "standard", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "N\u1ebfu th\u00f4ng tin EXIF t\u1ed3n t\u1ea1i (ng\u00e0y, gi\u1edd, m\u00e1y \u1ea3nh \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng, v.v.), n\u00f3 s\u1ebd \u0111\u01b0\u1ee3c hi\u1ec3n th\u1ecb.", "id": "pictures.usetags", "label": "Hi\u1ec3n th\u1ecb th\u00f4ng tin EXIF c\u1ee7a \u1ea3nh", "level": "standard", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "T\u1ef1 \u0111\u1ed9ng t\u1ea1o h\u00ecnh thu nh\u1ecf khi v\u00e0o th\u01b0 m\u1ee5c h\u00ecnh \u1ea3nh.", "id": "pictures.generatethumbs", "label": "T\u1ef1 \u0111\u1ed9ng t\u1ea1o h\u00ecnh thu nh\u1ecf", "level": "basic", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Hi\u1ec3n th\u1ecb video trong danh s\u00e1ch t\u1eadp tin h\u00ecnh \u1ea3nh.", "id": "pictures.showvideos", "label": "Hi\u1ec3n th\u1ecb t\u1eadp tin video trong danh s\u00e1ch", "level": "basic", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "string", "multiselect": true, "type": "list"}, "default": [], "definition": {"control": {"delayed": false, "format": "string", "multiselect": true, "type": "list"}, "default": 0, "enabled": true, "help": "Cho ph\u00e9p t\u1ef1 \u0111\u1ed9ng ph\u00e1t t\u1eadp tin ti\u1ebfp theo trong danh s\u00e1ch ph\u00e1t \u0111\u00e3 ch\u1ecdn.", "id": "videoplayer.autoplaynextitem.definition", "label": "T\u1ef1 \u0111\u1ed9ng ph\u00e1t video ti\u1ebfp theo", "level": "basic", "options": [{"label": "Video nh\u1ea1c", "value": 0}, {"label": "Ch\u01b0\u01a1ng tr\u00ecnh TV", "value": 1}, {"label": "T\u1eadp", "value": 2}, {"label": "Phim", "value": 3}, {"label": "Ch\u01b0a ph\u00e2n lo\u1ea1i", "value": 4}], "parent": "", "type": "integer", "value": 0}, "delimiter": ",", "elementtype": "integer", "enabled": true, "help": "Cho ph\u00e9p t\u1ef1 \u0111\u1ed9ng ph\u00e1t t\u1eadp tin ti\u1ebfp theo trong danh s\u00e1ch ph\u00e1t \u0111\u00e3 ch\u1ecdn.", "id": "videoplayer.autoplaynextitem", "label": "T\u1ef1 \u0111\u1ed9ng ph\u00e1t video ti\u1ebfp theo", "level": "basic", "maximumItems": -1, "minimumItems": 0, "parent": "", "type": "list", "value": []}, {"control": {"delayed": false, "format": "string", "multiselect": true, "type": "list"}, "default": [-600, -300, -180, -60, -30, -10, 10, 30, 60, 180, 300, 600], "definition": {"control": {"delayed": false, "format": "string", "multiselect": true, "type": "list"}, "default": -600, "enabled": true, "help": "X\u00e1c \u0111\u1ecbnh th\u1eddi l\u01b0\u1ee3ng tua s\u1ebd s\u1eed d\u1ee5ng khi nh\u1ea5n n\u00fat tua. N\u1ebfu nhi\u1ec1u b\u01b0\u1edbc \u0111\u01b0\u1ee3c ch\u1ecdn cho c\u00f9ng h\u01b0\u1edbng tua, nh\u1eefng b\u01b0\u1edbc n\u00e0y c\u00f3 th\u1ec3 \u0111\u01b0\u1ee3c \u00e1p d\u1ee5ng b\u1eb1ng c\u00e1c l\u1ea7n nh\u1ea5n ti\u1ebfp theo tr\u00ean n\u00fat tua trong \u0111\u1ed9 tr\u1ec5 tua \u0111\u01b0\u1ee3c x\u00e1c \u0111\u1ecbnh. C\u00e1c b\u01b0\u1edbc tua t\u1edbi v\u00e0 l\u00f9i c\u00f3 th\u1ec3 \u0111\u01b0\u1ee3c x\u00e1c \u0111\u1ecbnh \u0111\u1ed9c l\u1eadp.", "id": "videoplayer.seeksteps.definition", "label": "Th\u1eddi l\u01b0\u1ee3ng tua", "level": "standard", "options": [{"label": "-30 ph\u00fat", "value": -1800}, {"label": "-10 ph\u00fat", "value": -600}, {"label": "-5 ph\u00fat", "value": -300}, {"label": "-3 ph\u00fat", "value": -180}, {"label": "-60 gi\u00e2y", "value": -60}, {"label": "-30 gi\u00e2y", "value": -30}, {"label": "-10 gi\u00e2y", "value": -10}, {"label": "10 gi\u00e2y", "value": 10}, {"label": "30 gi\u00e2y", "value": 30}, {"label": "60 gi\u00e2y", "value": 60}, {"label": "3 ph\u00fat", "value": 180}, {"label": "5 ph\u00fat", "value": 300}, {"label": "10 ph\u00fat", "value": 600}, {"label": "30 ph\u00fat", "value": 1800}], "parent": "", "type": "integer", "value": -600}, "delimiter": ",", "elementtype": "integer", "enabled": true, "help": "X\u00e1c \u0111\u1ecbnh th\u1eddi l\u01b0\u1ee3ng tua s\u1ebd s\u1eed d\u1ee5ng khi nh\u1ea5n n\u00fat tua. N\u1ebfu nhi\u1ec1u b\u01b0\u1edbc \u0111\u01b0\u1ee3c ch\u1ecdn cho c\u00f9ng h\u01b0\u1edbng tua, nh\u1eefng b\u01b0\u1edbc n\u00e0y c\u00f3 th\u1ec3 \u0111\u01b0\u1ee3c \u00e1p d\u1ee5ng b\u1eb1ng c\u00e1c l\u1ea7n nh\u1ea5n ti\u1ebfp theo tr\u00ean n\u00fat tua trong \u0111\u1ed9 tr\u1ec5 tua \u0111\u01b0\u1ee3c x\u00e1c \u0111\u1ecbnh. C\u00e1c b\u01b0\u1edbc tua t\u1edbi v\u00e0 l\u00f9i c\u00f3 th\u1ec3 \u0111\u01b0\u1ee3c x\u00e1c \u0111\u1ecbnh \u0111\u1ed9c l\u1eadp.", "id": "videoplayer.seeksteps", "label": "Th\u1eddi l\u01b0\u1ee3ng tua", "level": "standard", "maximumItems": -1, "minimumItems": 2, "parent": "", "type": "list", "value": [-600, -300, -180, -60, -30, -10, 10, 30, 60, 180, 300, 600]}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d} ms", "minimumlabel": "Kh\u00f4ng", "type": "spinner"}, "default": 750, "enabled": true, "help": "X\u00e1c \u0111\u1ecbnh th\u1eddi gian ch\u1edd \u0111\u1ee3i c\u00e1c l\u1ea7n nh\u1ea5n ph\u00edm ti\u1ebfp theo tr\u01b0\u1edbc khi th\u1ef1c hi\u1ec7n b\u1ecf qua. Ch\u1ec9 \u00e1p d\u1ee5ng khi s\u1eed d\u1ee5ng b\u1ecf qua th\u00f4ng minh (khi s\u1eed d\u1ee5ng nhi\u1ec1u h\u01a1n m\u1ed9t b\u01b0\u1edbc b\u1ecf qua cho m\u1ed9t h\u01b0\u1edbng).", "id": "videoplayer.seekdelay", "label": "\u0110\u1ed9 tr\u1ec5 khi tua", "level": "standard", "maximum": 3000, "minimum": 0, "parent": "", "step": 250, "type": "integer", "value": 750}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 0, "enabled": true, "help": "Cho ph\u00e9p thay \u0111\u1ed5i t\u1ed1c \u0111\u1ed9 l\u00e0m m\u1edbi c\u1ee7a m\u00e0n h\u00ecnh \u0111\u1ec3 ph\u00f9 h\u1ee3p v\u1edbi t\u1ed1c \u0111\u1ed9 khung h\u00ecnh video. \u0110i\u1ec1u n\u00e0y c\u00f3 th\u1ec3 gi\u00fap video m\u01b0\u1ee3t m\u00e0 h\u01a1n.", "id": "videoplayer.adjustrefreshrate", "label": "\u0110i\u1ec1u ch\u1ec9nh t\u1ed1c \u0111\u1ed9 l\u00e0m m\u1edbi hi\u1ec3n th\u1ecb", "level": "standard", "options": [{"label": "T\u1eaft", "value": 0}, {"label": "Lu\u00f4n lu\u00f4n", "value": 1}, {"label": "Khi kh\u1edfi \u0111\u1ed9ng/d\u1eebng", "value": 2}, {"label": "Khi kh\u1edfi \u0111\u1ed9ng", "value": 3}], "parent": "", "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "\u0110\u1ed3ng b\u1ed9 h\u00f3a video v\u00e0 \u00e2m thanh v\u1edbi t\u1ed1c \u0111\u1ed9 l\u00e0m m\u1edbi m\u00e0n h\u00ecnh. VideoPlayer s\u1ebd kh\u00f4ng s\u1eed d\u1ee5ng \u00e2m thanh passthrough trong tr\u01b0\u1eddng h\u1ee3p n\u00e0y v\u00ec c\u00f3 th\u1ec3 c\u1ea7n ph\u1ea3i l\u1ea5y m\u1eabu l\u1ea1i.", "id": "videoplayer.usedisplayasclock", "label": "\u0110\u1ed3ng b\u1ed9 ph\u00e1t \u0111\u1ec3 hi\u1ec3n th\u1ecb", "level": "standard", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d} %", "minimumlabel": "T\u1eaft", "type": "spinner"}, "default": 0, "enabled": true, "help": "K\u00e9o d\u00e0i video l\u00ean \u0111\u1ebfn ph\u1ea7n tr\u0103m \u0111\u00e3 \u0111\u1eb7t \u0111\u1ec3 gi\u1ea3m thi\u1ec3u c\u00e1c thanh m\u00e0u \u0111en.", "id": "videoplayer.errorinaspect", "label": "Gi\u1ea3m thi\u1ec3u c\u00e1c thanh m\u00e0u \u0111en", "level": "advanced", "maximum": 20, "minimum": 0, "parent": "", "step": 1, "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 0, "enabled": true, "help": "Ch\u1ecdn m\u1ee9c thu ph\u00f3ng m\u00e0 video 4:3 s\u1ebd hi\u1ec3n th\u1ecb tr\u00ean m\u00e0n h\u00ecnh r\u1ed9ng.", "id": "videoplayer.stretch43", "label": "Hi\u1ec3n th\u1ecb video 4:3 theo", "level": "advanced", "options": [{"label": "B\u00ecnh th\u01b0\u1eddng", "value": 0}, {"label": "Ph\u00f3ng to", "value": 3}, {"label": "T\u1ec9 l\u1ec7 m\u00e0n h\u00ecnh 16:9", "value": 4}, {"label": "K\u00e9o gi\u00e3n t\u1ec9 l\u1ec7 16:9 - kh\u00f4ng vi\u1ec1n", "value": 7}, {"label": "Thu ph\u00f3ng", "value": 1}], "parent": "", "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 0, "enabled": true, "help": "\u0110i\u1ec1u ch\u1ec9nh ph\u01b0\u01a1ng ph\u00e1p \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng \u0111\u1ec3 x\u1eed l\u00fd v\u00e0 hi\u1ec3n th\u1ecb video.", "id": "videoplayer.rendermethod", "label": "Ph\u01b0\u01a1ng ph\u00e1p render", "level": "advanced", "options": [{"label": "T\u1ef1 \u0111\u1ed9ng d\u00f2 t\u00ecm", "value": 0}, {"label": "DXVA", "value": 4}, {"label": "Pixel shaders", "value": 3}, {"label": "Ph\u1ea7n m\u1ec1m", "value": 2}], "parent": "", "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d} %", "type": "spinner"}, "default": 20, "enabled": true, "help": "S\u1eed d\u1ee5ng c\u00e1c c\u00f4ng c\u1ee5 thu nh\u1ecf ch\u1ea5t l\u01b0\u1ee3ng cao khi n\u00e2ng c\u1ea5p video \u00edt nh\u1ea5t l\u00e0 t\u1ef7 l\u1ec7 n\u00e0y. Gi\u00e1 tr\u1ecb d\u01b0\u1edbi 5% kh\u00f4ng c\u00f3 \u00fd ngh\u0129a g\u00ec khi video \u0111\u01b0\u1ee3c x\u1eed l\u00fd v\u1edbi t\u1ea3i GPU cao m\u00e0 kh\u00f4ng c\u00f3 b\u1ea5t k\u1ef3 c\u1ea3i thi\u1ec7n ch\u1ea5t l\u01b0\u1ee3ng h\u00ecnh \u1ea3nh r\u00f5 r\u00e0ng n\u00e0o.", "id": "videoplayer.hqscalers", "label": "Enable HQ scalers for scaling above", "level": "advanced", "maximum": 100, "minimum": 0, "parent": "videoplayer.rendermethod", "step": 10, "type": "integer", "value": 20}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Enables advanced DXVA upscaler using NVIDIA \"RTX Video Super Resolution\" or \"Intel Video Super Resolution\".[CR]Used when the video source is 1920x1080 or less and the source resolution is lower than the display resolution.[CR]Only available on specific hardware: NVIDIA RTX 20xx, 30xx, 40xx and above, Intel Arc A770, A750.", "id": "videoplayer.usesuperresolution", "label": "Allow use DXVA Video Super Resolution", "level": "advanced", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "B\u1eadt gi\u1ea3i m\u00e3 ph\u1ea7n c\u1ee9ng DXVA2 c\u1ee7a c\u00e1c t\u1eadp tin video.", "id": "videoplayer.usedxva2", "label": "Cho ph\u00e9p t\u0103ng t\u1ed1c ph\u1ea7n c\u1ee9ng - DXVA2", "level": "advanced", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Enable this option for the best picture quality. Disabling reduces the load on resource-limited systems.", "id": "videoplayer.highprecision", "label": "Use high precision processing", "level": "advanced", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": true, "format": "integer", "formatlabel": "{}", "type": "spinner"}, "default": 0, "enabled": true, "help": "Ch\u1ecdn ch\u1ebf \u0111\u1ed9 video 3D l\u1eadp th\u1ec3 s\u1ebd \u0111\u01b0\u1ee3c ph\u00e1t.[CR][H\u1ecfi t\u00f4i] S\u1ebd hi\u1ec3n th\u1ecb h\u1ed9p tho\u1ea1i \u0111\u1ec3 ch\u1ecdn ch\u1ebf \u0111\u1ed9 mong mu\u1ed1n cho m\u1ed7i l\u1ea7n ph\u00e1t.[CR][Ch\u1ebf \u0111\u1ed9 \u01b0u ti\u00ean] S\u1ebd s\u1eed d\u1ee5ng ch\u1ebf \u0111\u1ed9 \u01b0u ti\u00ean \u0111\u01b0\u1ee3c ch\u1ec9 \u0111\u1ecbnh trong \"H\u1ec7 th\u1ed1ng -> Ph\u1ea7n c\u1ee9ng video\" c\u1ee7a ph\u1ea7n c\u00e0i \u0111\u1eb7t.[CR][Monoscopic/2D] S\u1ebd ph\u00e1t video \u1edf ch\u1ebf \u0111\u1ed9 \u0111\u01a1n/2D.[CR][B\u1ecf qua] T\u1eaft m\u1ecdi x\u1eed l\u00fd cho 3D l\u1eadp th\u1ec3.", "id": "videoplayer.stereoscopicplaybackmode", "label": "Ch\u1ebf \u0111\u1ed9 ph\u00e1t cho video 3D l\u1eadp th\u1ec3", "level": "advanced", "options": [{"label": "H\u1ecfi t\u00f4i", "value": 0}, {"label": "Ch\u1ebf \u0111\u1ed9 \u01b0u ti\u00ean", "value": 1}, {"label": "Monoscopic/2D", "value": 2}, {"label": "B\u1ecf qua", "value": 100}], "parent": "", "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "[Enabled] Switch GUI (and some TVs) back to 2D mode, between videos in a playlist or when playback ended.[CR][Disabled] GUI and TV will stay in stereoscopic 3D mode. For video playlists with mixed stereoscopic 3D and 2D content, then the GUI will also stay in stereoscopic 3D mode even when a non-stereoscopic 2D video is playing.", "id": "videoplayer.quitstereomodeonstop", "label": "T\u1eaft ch\u1ebf \u0111\u1ed9 3D l\u1eadp th\u1ec3 khi k\u1ebft th\u00fac ph\u00e1t", "level": "advanced", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "B\u1eadt teletext khi xem m\u1ed9t lu\u1ed3ng truy\u1ec1n h\u00ecnh tr\u1ef1c ti\u1ebfp.", "id": "videoplayer.teletextenabled", "label": "K\u00edch ho\u1ea1t teletext", "level": "expert", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Chuy\u1ec3n t\u1ec9 l\u1ec7 teletext sang 4:3.", "id": "videoplayer.teletextscale", "label": "Chuy\u1ec3n t\u1ec9 l\u1ec7 teletext sang 4:3", "level": "expert", "parent": "videoplayer.teletextenabled", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "T\u1ef1 \u0111\u1ed9ng ph\u00e1t m\u1ee5c ti\u1ebfp theo trong th\u01b0 m\u1ee5c hi\u1ec7n t\u1ea1i, v\u00ed d\u1ee5 nh\u01b0 trong ch\u1ebf \u0111\u1ed9 xem \"T\u1eadp tin\" sau khi b\u1ea3n nh\u1ea1c \u0111\u01b0\u1ee3c ph\u00e1t, b\u1ea3n nh\u1ea1c ti\u1ebfp theo trong c\u00f9ng th\u01b0 m\u1ee5c s\u1ebd t\u1ef1 \u0111\u1ed9ng ph\u00e1t.", "id": "musicplayer.autoplaynextitem", "label": "T\u1ef1 \u0111\u1ed9ng ph\u00e1t b\u00e0i h\u00e1t ti\u1ebfp theo", "level": "basic", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Khi b\u00e0i h\u00e1t \u0111\u01b0\u1ee3c ch\u1ecdn, ch\u00fang \u0111\u01b0\u1ee3c th\u00eam v\u00e0o danh s\u00e1ch ch\u1edd thay v\u00ec ph\u00e1t ngay l\u1eadp t\u1ee9c.", "id": "musicplayer.queuebydefault", "label": "Ch\u00e8n th\u00eam b\u00e0i h\u00e1t v\u00e0o danh s\u00e1ch khi ch\u1ecdn", "level": "basic", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "string", "multiselect": true, "type": "list"}, "default": [-60, -30, -10, 10, 30, 60], "definition": {"control": {"delayed": false, "format": "string", "multiselect": true, "type": "list"}, "default": -60, "enabled": true, "help": "X\u00e1c \u0111\u1ecbnh th\u1eddi l\u01b0\u1ee3ng tua s\u1ebd s\u1eed d\u1ee5ng khi nh\u1ea5n n\u00fat tua. N\u1ebfu nhi\u1ec1u b\u01b0\u1edbc \u0111\u01b0\u1ee3c ch\u1ecdn cho c\u00f9ng h\u01b0\u1edbng tua, nh\u1eefng b\u01b0\u1edbc n\u00e0y c\u00f3 th\u1ec3 \u0111\u01b0\u1ee3c \u00e1p d\u1ee5ng b\u1eb1ng c\u00e1c l\u1ea7n nh\u1ea5n ti\u1ebfp theo tr\u00ean n\u00fat tua trong \u0111\u1ed9 tr\u1ec5 tua \u0111\u01b0\u1ee3c x\u00e1c \u0111\u1ecbnh. C\u00e1c b\u01b0\u1edbc tua t\u1edbi v\u00e0 l\u00f9i c\u00f3 th\u1ec3 \u0111\u01b0\u1ee3c x\u00e1c \u0111\u1ecbnh \u0111\u1ed9c l\u1eadp.", "id": "musicplayer.seeksteps.definition", "label": "Th\u1eddi l\u01b0\u1ee3ng tua", "level": "standard", "options": [{"label": "-30 ph\u00fat", "value": -1800}, {"label": "-10 ph\u00fat", "value": -600}, {"label": "-5 ph\u00fat", "value": -300}, {"label": "-3 ph\u00fat", "value": -180}, {"label": "-60 gi\u00e2y", "value": -60}, {"label": "-30 gi\u00e2y", "value": -30}, {"label": "-10 gi\u00e2y", "value": -10}, {"label": "10 gi\u00e2y", "value": 10}, {"label": "30 gi\u00e2y", "value": 30}, {"label": "60 gi\u00e2y", "value": 60}, {"label": "3 ph\u00fat", "value": 180}, {"label": "5 ph\u00fat", "value": 300}, {"label": "10 ph\u00fat", "value": 600}, {"label": "30 ph\u00fat", "value": 1800}], "parent": "", "type": "integer", "value": -60}, "delimiter": ",", "elementtype": "integer", "enabled": true, "help": "X\u00e1c \u0111\u1ecbnh th\u1eddi l\u01b0\u1ee3ng tua s\u1ebd s\u1eed d\u1ee5ng khi nh\u1ea5n n\u00fat tua. N\u1ebfu nhi\u1ec1u b\u01b0\u1edbc \u0111\u01b0\u1ee3c ch\u1ecdn cho c\u00f9ng h\u01b0\u1edbng tua, nh\u1eefng b\u01b0\u1edbc n\u00e0y c\u00f3 th\u1ec3 \u0111\u01b0\u1ee3c \u00e1p d\u1ee5ng b\u1eb1ng c\u00e1c l\u1ea7n nh\u1ea5n ti\u1ebfp theo tr\u00ean n\u00fat tua trong \u0111\u1ed9 tr\u1ec5 tua \u0111\u01b0\u1ee3c x\u00e1c \u0111\u1ecbnh. C\u00e1c b\u01b0\u1edbc tua t\u1edbi v\u00e0 l\u00f9i c\u00f3 th\u1ec3 \u0111\u01b0\u1ee3c x\u00e1c \u0111\u1ecbnh \u0111\u1ed9c l\u1eadp.", "id": "musicplayer.seeksteps", "label": "Th\u1eddi l\u01b0\u1ee3ng tua", "level": "standard", "maximumItems": -1, "minimumItems": 2, "parent": "", "type": "list", "value": [-60, -30, -10, 10, 30, 60]}, {"control": {"delayed": false, "format": "string", "formatlabe