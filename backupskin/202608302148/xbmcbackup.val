n c\u00f3 b\u0103ng th\u00f4ng h\u1ea1n ch\u1ebf, h\u00e3y s\u1eed d\u1ee5ng c\u00e0i \u0111\u1eb7t n\u00e0y \u0111\u1ec3 gi\u1eef cho vi\u1ec7c s\u1eed d\u1ee5ng b\u0103ng th\u00f4ng c\u1ee7a \u1ee9ng d\u1ee5ng trong gi\u1edbi h\u1ea1n x\u00e1c \u0111\u1ecbnh.", "id": "network.bandwidth", "label": "Gi\u1edbi h\u1ea1n b\u0103ng th\u00f4ng k\u1ebft n\u1ed1i internet", "level": "standard", "maximum": 102400, "minimum": 0, "parent": "", "step": 512, "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d} ph\u00fat", "minimumlabel": "T\u1eaft", "type": "spinner"}, "default": 0, "enabled": true, "help": "Turn off display when idle. Useful for TVs that turn off when there is no display signal detected.", "id": "powermanagement.displaysoff", "label": "Chuy\u1ec3n m\u00e0n h\u00ecnh sang ch\u1ebf \u0111\u1ed9 ng\u1ee7 khi m\u00e1y kh\u00f4ng v\u1eadn h\u00e0nh", "level": "basic", "maximum": 120, "minimum": 0, "parent": "", "step": 5, "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d} ph\u00fat", "minimumlabel": "T\u1eaft", "type": "spinner"}, "default": 0, "enabled": true, "help": "Set the time to wait for any activity to occur before shutting down.", "id": "powermanagement.shutdowntime", "label": "Ch\u1ee9c n\u0103ng h\u1eb9n gi\u1edd t\u1eaft m\u00e1y", "level": "advanced", "maximum": 120, "minimum": 0, "parent": "", "step": 5, "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 0, "enabled": true, "help": "Define what action to perform when the shutdown function timer lapsed.", "id": "powermanagement.shutdownstate", "label": "Ch\u1ee9c n\u0103ng t\u1eaft m\u00e1y", "level": "advanced", "options": [{"label": "T\u1eaft m\u00e1y", "value": 1}, {"label": "Hibernate", "value": 2}, {"label": "Ch\u1ebf \u0111\u1ed9 ch\u1edd", "value": 3}, {"label": "Tho\u00e1t", "value": 0}, {"label": "Thu nh\u1ecf", "value": 5}], "parent": "", "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d} gi\u00e2y", "minimumlabel": "T\u1eaft", "type": "spinner"}, "default": 0, "enabled": true, "help": "\u0110\u1eb7t th\u1eddi gian t\u1ed1i \u0111a \u0111\u1ec3 ch\u1edd m\u1ea1ng xu\u1ea5t hi\u1ec7n sau khi b\u1eaft \u0111\u1ea7u ho\u1eb7c th\u1ee9c d\u1eady. Khi th\u1eddi gian tr\u00f4i qua tr\u01b0\u1edbc khi m\u1ea1ng kh\u1edfi \u0111\u1ed9ng s\u1ebd ti\u1ebfp t\u1ee5c.", "id": "powermanagement.waitfornetwork", "label": "Th\u1eddi gian ch\u1edd t\u1ed1i \u0111a cho m\u1ea1ng", "level": "advanced", "maximum": 30, "minimum": 0, "parent": "", "step": 1, "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "T\u1ef1 \u0111\u1ed9ng g\u1eedi Wake-on-LAN \u0111\u1ebfn m\u00e1y ch\u1ee7 tr\u01b0\u1edbc khi th\u1eed truy c\u1eadp t\u1eadp tin ho\u1eb7c d\u1ecbch v\u1ee5 \u0111\u01b0\u1ee3c chia s\u1ebb.", "id": "powermanagement.wakeonaccess", "label": "C\u1ed1 g\u1eafng \u0111\u00e1nh th\u1ee9c m\u00e1y ch\u1ee7 t\u1eeb xa khi truy c\u1eadp", "level": "standard", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 0, "enabled": true, "help": "Thay \u0111\u1ed5i c\u00e1ch t\u1ef1 \u0111\u1ed9ng c\u1eadp nh\u1eadt ti\u1ec7n \u00edch \u0111\u01b0\u1ee3c x\u1eed l\u00fd.", "id": "general.addonupdates", "label": "C\u1eadp nh\u1eadt", "level": "basic", "options": [{"label": "T\u1ef1 \u0111\u1ed9ng c\u00e0i \u0111\u1eb7t b\u1ea3n c\u1eadp nh\u1eadt", "value": 0}, {"label": "Ch\u1ec9 th\u00f4ng b\u00e1o, nh\u01b0ng kh\u00f4ng c\u00e0i \u0111\u1eb7t b\u1ea3n c\u1eadp nh\u1eadt", "value": 1}, {"label": "Kh\u00f4ng bao gi\u1edd ki\u1ec3m tra c\u1eadp nh\u1eadt", "value": 2}], "parent": "", "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Hi\u1ec3n th\u1ecb th\u00f4ng b\u00e1o khi m\u1ed9t ti\u1ec7n \u00edch \u0111\u00e3 \u0111\u01b0\u1ee3c c\u1eadp nh\u1eadt.", "id": "general.addonnotifications", "label": "Hi\u1ec3n th\u1ecb th\u00f4ng b\u00e1o", "level": "basic", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": true, "help": "M\u00f4-\u0111un qu\u1ea3n l\u00fd v\u00e0 th\u01b0 vi\u1ec7n h\u1ed7 tr\u1ee3 \u0111\u00e3 \u0111\u01b0\u1ee3c c\u00e0i \u0111\u1eb7t t\u1ef1 \u0111\u1ed9ng nh\u01b0 m\u1ed9t ph\u1ea7n ph\u1ee5 tr\u1ee3 c\u1ee7a c\u00e1c ti\u1ec7n \u00edch kh\u00e1c. C\u00e1c m\u1ee5c \u0111\u01b0\u1ee3c li\u1ec7t k\u00ea l\u00e0 \"\u0110\u1ed9c l\u1eadp\" kh\u00f4ng c\u00f2n b\u1ecb r\u00e0ng bu\u1ed9c b\u1edfi b\u1ea5t k\u1ef3 ti\u1ec7n \u00edch n\u00e0o v\u00e0 an to\u00e0n \u0111\u1ec3 g\u1ee1 c\u00e0i \u0111\u1eb7t.", "id": "addons.managedependencies", "label": "Qu\u1ea3n l\u00fd ph\u1ee5 tr\u1ee3", "level": "advanced", "parent": "", "type": "action"}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": true, "help": "Remove all modules and support libraries that have been automatically installed and are in an orphaned state.", "id": "addons.removeorphaneddependencies", "label": "Remove all orphaned add-ons", "level": "advanced", "parent": "", "type": "action"}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": true, "help": "Hi\u1ec3n th\u1ecb c\u00e1c ti\u1ec7n \u00edch \u0111ang ch\u1ea1y trong n\u1ec1n.", "id": "addons.showrunning", "label": "\u0110ang ch\u1ea1y", "level": "advanced", "parent": "", "type": "action"}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Cho ph\u00e9p c\u00e0i \u0111\u1eb7t ti\u1ec7n \u00edch t\u1eeb ngu\u1ed3n kh\u00f4ng x\u00e1c \u0111\u1ecbnh.", "id": "addons.unknownsources", "label": "Kh\u00f4ng r\u00f5 ngu\u1ed3n g\u1ed1c", "level": "basic", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 1, "enabled": true, "help": "Theo m\u1eb7c \u0111\u1ecbnh, ti\u1ec7n \u00edch t\u1eeb c\u00e1c kho l\u01b0u tr\u1eef ch\u00ednh th\u1ee9c s\u1ebd kh\u00f4ng th\u1ec3 t\u1ef1 \u0111\u1ed9ng c\u1eadp nh\u1eadt t\u1eeb c\u00e1c kho l\u01b0u tr\u1eef ri\u00eang. \u0110\u1ed1i v\u1edbi c\u00e1c tr\u01b0\u1eddng h\u1ee3p nh\u01b0 c\u1eadp nh\u1eadt t\u1eeb kho l\u01b0u tr\u1eef beta c\u1ee7a ti\u1ec7n \u00edch, t\u00f9y ch\u1ecdn n\u00e0y c\u00f3 th\u1ec3 \u0111\u01b0\u1ee3c chuy\u1ec3n sang [B\u1ea5t k\u1ef3 kho l\u01b0u tr\u1eef n\u00e0o] (l\u01b0u \u00fd r\u1eb1ng \u0111\u00e2y l\u00e0 m\u1ed9t t\u00f9y ch\u1ecdn k\u00e9m an to\u00e0n v\u00e0 vi\u1ec7c b\u1eadt n\u00f3 c\u00f3 th\u1ec3 g\u00e2y ra s\u1ef1 kh\u00f4ng t\u01b0\u01a1ng th\u00edch v\u00e0 s\u1ef1 c\u1ed1).", "id": "addons.updatemode", "label": "C\u1eadp nh\u1eadt c\u00e1c ti\u1ec7n \u00edch ch\u00ednh th\u1ee9c t\u1eeb", "level": "standard", "options": [{"label": "Ch\u1ec9 kho l\u01b0u tr\u1eef ch\u00ednh th\u1ee9c (m\u1eb7c \u0111\u1ecbnh)", "value": 0}, {"label": "B\u1ea5t k\u1ef3 kho l\u01b0u tr\u1eef n\u00e0o", "value": 1}], "parent": "addons.unknownsources", "type": "integer", "value": 1}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "B\u1eadt ho\u1eb7c t\u1eaft nh\u1eadt k\u00fd g\u1ee1 l\u1ed7i. H\u1eefu \u00edch cho vi\u1ec7c kh\u1eafc ph\u1ee5c s\u1ef1 c\u1ed1.", "id": "debug.showloginfo", "label": "Cho ph\u00e9p ghi nh\u1eadt k\u00fd g\u1ee1 l\u1ed7i", "level": "standard", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Cho ph\u00e9p th\u00f4ng b\u00e1o d\u00e0i t\u1e