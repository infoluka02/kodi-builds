boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "T\u1ea1m d\u1eebng video hi\u1ec7n t\u1ea1i trong khi t\u00ecm ki\u1ebfm ph\u1ee5 \u0111\u1ec1 v\u00e0 ti\u1ebfp t\u1ee5c sau khi ph\u1ee5 \u0111\u1ec1 c\u00f3 s\u1eb5n.", "id": "subtitles.pauseonsearch", "label": "T\u1ea1m d\u1eebng khi \u0111ang t\u00ecm ki\u1ebfm ph\u1ee5 \u0111\u1ec1", "level": "advanced", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "T\u1ef1 \u0111\u1ed9ng t\u1ea3i xu\u1ed1ng ph\u1ee5 \u0111\u1ec1 \u0111\u1ea7u ti\u00ean t\u1eeb danh s\u00e1ch k\u1ebft qu\u1ea3 t\u00ecm ki\u1ebfm", "id": "subtitles.downloadfirst", "label": "T\u1ef1 \u0111\u1ed9ng t\u1ea3i xu\u1ed1ng ph\u1ee5 \u0111\u1ec1 \u0111\u1ea7u ti\u00ean", "level": "advanced", "parent": "", "type": "boolean", "value": false}, {"addontype": "xbmc.subtitle.module", "allowempty": true, "allownewoption": false, "control": {"delayed": false, "format": "addon", "type": "button"}, "default": "", "enabled": true, "help": "Ch\u1ecdn d\u1ecbch v\u1ee5 s\u1ebd \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng l\u00e0m m\u1eb7c \u0111\u1ecbnh \u0111\u1ec3 t\u00ecm ki\u1ebfm ph\u1ee5 \u0111\u1ec1 ch\u01b0\u01a1ng tr\u00ecnh TV.", "id": "subtitles.tv", "label": "D\u1ecbch v\u1ee5 ch\u01b0\u01a1ng tr\u00ecnh TV m\u1eb7c \u0111\u1ecbnh", "level": "standard", "parent": "", "type": "addon", "value": ""}, {"addontype": "xbmc.subtitle.module", "allowempty": true, "allownewoption": false, "control": {"delayed": false, "format": "addon", "type": "button"}, "default": "", "enabled": true, "help": "Ch\u1ecdn d\u1ecbch v\u1ee5 s\u1ebd \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng l\u00e0m m\u1eb7c \u0111\u1ecbnh \u0111\u1ec3 t\u00ecm ki\u1ebfm ph\u1ee5 \u0111\u1ec1 phim.", "id": "subtitles.movie", "label": "D\u1ecbch v\u1ee5 phim m\u1eb7c \u0111\u1ecbnh", "level": "standard", "parent": "", "type": "addon", "value": ""}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": true, "help": "Display and manage available PVR client add-ons.", "id": "pvrmanager.addons", "label": "PVR client add-ons", "level": "standard", "parent": "", "type": "action"}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": true, "help": "This option will bring you to any specific settings for your PVR backend, if supported by the PVR add-on and backend.", "id": "pvrclient.menuhook", "label": "Thi\u1ebft l\u1eadp chuy\u00ean bi\u1ec7t cho m\u00e1y kh\u00e1ch", "level": "standard", "parent": "", "type": "action"}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": true, "help": "Clear the databases for PVR data like channels, groups, reminders and guide. Please note that not all data can be restored from the backend afterwards.", "id": "pvrmanager.resetdb", "label": "X\u00f3a d\u1eef li\u1ec7u", "level": "standard", "parent": "", "type": "action"}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Sort channel groups by the order supplied by the backend(s). If enabled, groups cannot be reordered in the Group manager", "id": "pvrmanager.backendchannelgroupsorder", "label": "Use channel group order from backend(s)", "level": "advanced", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "S\u1eafp x\u1ebfp c\u00e1c k\u00eanh theo s\u1ed1 k\u00eanh t\u1eeb ph\u1ee5 tr\u1ee3, nh\u01b0ng s\u1eed d\u1ee5ng \u0111\u00e1nh s\u1ed1 c\u1ee5c b\u1ed9 cho c\u00e1c k\u00eanh.", "id": "pvrmanager.backendchannelorder", "label": "S\u1eed d\u1ee5ng th\u1ee9 t\u1ef1 k\u00eanh t\u1eeb ph\u1ee5 tr\u1ee3", "level": "advanced", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": true, "help": "M\u1edf tr\u00ecnh qu\u1ea3n l\u00fd k\u00eanh, cho ph\u00e9p s\u1eeda \u0111\u1ed5i th\u1ee9 t\u1ef1 k\u00eanh, t\u00ean k\u00eanh, bi\u1ec3u t\u01b0\u1ee3ng, v. v.", "id": "pvrmanager.channelmanager", "label": "Qu\u1ea3n l\u00fd k\u00eanh", "level": "standard", "parent": "", "type": "action"}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": true, "help": "M\u1edf tr\u00ecnh qu\u1ea3n l\u00fd nh\u00f3m, cho ph\u00e9p s\u1eeda \u0111\u1ed5i nh\u00f3m v\u00e0 c\u00e1c k\u00eanh t\u01b0\u01a1ng \u1ee9ng c\u1ee7a h\u1ecd", "id": "pvrmanager.groupmanager", "label": "Qu\u1ea3n l\u00fd nh\u00f3m", "level": "standard", "parent": "", "type": "action"}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": true, "help": "H\u01b0\u1edbng d\u1eabn ph\u1ee5 tr\u1ee3 \u0111\u1ec3 t\u00ecm ki\u1ebfm c\u00e1c k\u00eanh (n\u1ebfu \u0111\u01b0\u1ee3c h\u1ed7 tr\u1ee3).", "id": "pvrmanager.channelscan", "label": "T\u00ecm ki\u1ebfm k\u00eanh", "level": "standard", "parent": "", "type": "action"}, {"allowempty": true, "allownewoption": false, "control": {"delayed": false, "format": "path", "heading": "Duy\u1ec7t th\u01b0 m\u1ee5c", "type": "button"}, "default": "", "enabled": true, "help": "Th\u01b0 m\u1ee5c l\u01b0u tr\u1eef bi\u1ec3u t\u01b0\u1ee3ng k\u00eanh.", "id": "pvrmenu.iconpath", "label": "Th\u01b0 m\u1ee5c v\u1edbi c\u00e1c bi\u1ec3u t\u01b0\u1ee3ng k\u00eanh", "level": "advanced", "parent": "", "sources": [], "type": "path", "value": "", "writable": false}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": false, "help": "Qu\u00e9t c\u00e1c bi\u1ec3u t\u01b0\u1ee3ng k\u00eanh b\u1ecb thi\u1ebfu.", "id": "pvrmenu.searchicons", "label": "Scan for missing icons", "level": "advanced", "parent": "", "type": "action"}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d} ng\u00e0y", "type": "spinner"}, "default": 1, "enabled": true, "help": "Number of past days to show in the guide and to import from backends.", "id": "epg.pastdaystodisplay", "label": "Past days to display", "level": "advanced", "maximum": 31, "minimum": 0, "parent": "", "step": 1, "type": "integer", "value": 1}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d} ng\u00e0y", "type": "spinner"}, "default": 3, "enabled": true, "help": "S\u1ed1 ng\u00e0y trong t\u01b0\u01a1ng lai s\u1ebd hi\u1ec3n th\u1ecb trong h\u01b0\u1edbng d\u1eabn v\u00e0 nh\u1eadp t\u1eeb ph\u1ee5 tr\u1ee3.", "id": "epg.futuredaystodisplay", "label": "Future days to display", "level": "advanced", "maximum": 31, "minimum": 1, "parent": "", "step": 1, "type": "integer", "value": 3}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 2, "enabled": true, "help": "Select what will happen when an item is selected in the guide: [Show context menu] Will trigger the context menu from where you can choose further actions; [Switch to channel] Will instantly tune to the related channel; [Show information] Will display a detailed information with plot and further options; [Record] Will create a recording timer for the selected item. [\"Smart select\"] The action is choosen dynamically, depending on whether the event is in the past, now or in the future.", "id": "epg.selectaction", "label": "H\u00e0nh \u0111\u1ed9ng ch\u1ecdn m\u1eb7c \u0111\u1ecbnh", "level": "standard", "options": [{"label": "Show context menu", "value": 0}, {"label": "Chuy\u1ec3n t\u1edbi k\u00eanh", "value": 1}, {"label": "Hi\u1ec3n th\u1ecb th\u00f4ng tin", "value": 2}, {"label": "Thu \u00e2m", "value": 3}, {"label": "\"Smart select\"", "value": 5}], "parent": "", "type": "integer", "value": 2}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "\u1ea8n nh\u00e3n \"Kh\u00f4ng c\u00f3 th\u00f4ng tin\" khi kh\u00f4ng c\u00f3 d\u1eef li\u1ec7u h\u01b0\u1edbng d\u1eabn cho m\u1ed9t k\u00eanh.", "id": "epg.hidenoinfoavailable", "label": "\u1ea8n nh\u00e3n \"Kh\u00f4ng c\u00f3 th\u00f4ng tin\"", "level": "advanced", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d} ph\u00fat", "type": "spinner"}, "default": 120, "enabled": true, "help": "Time between imports of guide data from backends.", "id": "epg.epgupdate", "label": "Kho\u1ea3ng th\u1eddi gian c\u1eadp nh\u1eadt", "level": "advanced", "maximum": 2880, "minimum": 15, "parent": "", "step": 15, "type": "integer", "value": 120}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Kh\u00f4ng nh\u1eadp d\u1eef li\u1ec7u h\u01b0\u1edbng d\u1eabn trong khi ph\u00e1t TV \u0111\u1ec3 gi\u1ea3m thi\u1ec3u vi\u1ec7c s\u1eed d\u1ee5ng CPU.", "id": "epg.preventupdateswhileplayingtv", "label": "Ng\u0103n ch\u1eb7n c\u1eadp nh\u1eadt trong khi ph\u00e1t", "level": "advanced", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": true, "help": "X\u00f3a d\u1eef li\u1ec7u h\u01b0\u1edbng d\u1eabn l\u01b0u v\u00e0o b\u1ed9 nh\u1edb cache v\u00e0 nh\u1eadp l\u1ea1i t\u1eeb ph\u1ee5 tr\u1ee3.", "id": "epg.resetepg", "label": "X\u00f3a d\u1eef li\u1ec7u", "level": "standard", "parent": "", "type": "action"}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 3, "enabled": true, "help": "Switch to full screen display when starting playback of channels.", "id": "pvrplayback.switchtofullscreenchanneltypes", "label": "Chuy\u1ec3n sang to\u00e0n m\u00e0n h\u00ecnh", "level": "standard", "options": [{"label": "Kh\u00f4ng bao gi\u1edd", "value": 0}, {"label": "K\u00eanh TV", "value": 1}, {"label": "K\u00eanh Radio", "value": 2}, {"label": "K\u00eanh TV v\u00e0 Radio", "value": 3}], "parent": "", "type": "integer", "value": 3}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Ch\u1ecdn tr\u01b0\u1edbc k\u00eanh ph\u00e1t trong c\u1eeda s\u1ed5 v\u00e0 h\u1ed9p tho\u1ea1i ch\u1ee9a danh s\u00e1ch k\u00eanh. N\u1ebfu \u0111\u01b0\u1ee3c b\u1eadt v\u00e0 c\u00f3 k\u00eanh ph\u00e1t, k\u00eanh ph\u00e1t s\u1ebd \u0111\u01b0\u1ee3c ch\u1ecdn khi m\u1edf c\u1eeda s\u1ed5 ho\u1eb7c h\u1ed9p tho\u1ea1i ch\u1ee9a danh s\u00e1ch k\u00eanh. N\u1ebfu b\u1ecb t\u1eaft, k\u00eanh \u0111\u01b0\u1ee3c ch\u1ecdn tr\u01b0\u1edbc \u0111\u00f3 trong c\u1eeda s\u1ed5 ho\u1eb7c h\u1ed9p tho\u1ea1i s\u1ebd \u0111\u01b0\u1ee3c ch\u1ecdn khi m\u1edf c\u1eeda s\u1ed5 ch\u1ee9a danh s\u00e1ch k\u00eanh. ", "id": "pvrmanager.preselectplayingchannel", "label": "Ch\u1ecdn tr\u01b0\u1edbc k\u00eanh ph\u00e1t trong danh s\u00e1ch", "level": "standard", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d} gi\u00e2y", "minimumlabel": "T\u1eaft", "type": "spinner"}, "default": 5, "enabled": true, "help": "Hi\u1ec3n th\u1ecb th\u00f4ng tin l\u1eadp tr\u00ecnh khi thay \u0111\u1ed5i k\u00eanh, ch\u1eb3ng h\u1ea1n nh\u01b0 ch\u01b0\u01a1ng tr\u00ecnh TV hi\u1ec7n t\u1ea1i.", "id": "pvrmenu.displaychannelinfo", "label": "Hi\u1ec3n th\u1ecb th\u00f4ng tin k\u00eanh khi chuy\u1ec3n k\u00eanh", "level": "advanced", "maximum": 15, "minimum": 0, "parent": "", "step": 1, "type": "integer", "value": 5}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "\u0110\u00f3ng c\u00e1c \u0111i\u1ec1u khi\u1ec3n hi\u1ec3n th\u1ecb tr\u00ean m\u00e0n h\u00ecnh sau khi chuy\u1ec3n k\u00eanh.", "id": "pvrmenu.closechannelosdonswitch", "label": "\u0110\u00f3ng k\u00eanh OSD sau khi chuy\u1ec3n k\u00eanh", "level": "advanced", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "When flipping through channels using channel up/down buttons, channel switches must be confirmed using the OK button.", "id": "pvrplayback.confirmchannelswitch", "label": "X\u00e1c nh\u1eadn chuy\u1ec3n k\u00eanh b\u1eb1ng c\u00e1ch nh\u1ea5n \"OK\"", "level": "standard", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d} ms", "type": "spinner"}, "default": 0, "enabled": true, "help": "When pressing channel up or down, the actual channel switch is delayed, allowing the user to flip to a channel number without waiting for each channel switch.", "id": "pvrplayback.channelentrytimeout", "label": "\u0110\u1ed9 tr\u1ec5 khi chuy\u1ec3n k\u00eanh", "level": "advanced", "maximum": 10000, "minimum": 0, "parent": "", "step": 250, "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d} gi\u00e2y", "type": "spinner"}, "default": 0, "enabled": true, "help": "N\u1ebfu \u0111\u01b0\u1ee3c \u0111\u1eb7t th\u00e0nh gi\u00e1 tr\u1ecb l\u1edbn h\u01a1n 0, th\u1eddi gian xem k\u00eanh cu\u1ed1i c\u00f9ng s\u1ebd \u0111\u01b0\u1ee3c l\u01b0u tr\u1eef trong kho\u1ea3ng th\u1eddi gian nh\u1ea5t \u0111\u1ecbnh sau khi b\u1eaft \u0111\u1ea7u ph\u00e1t k\u00eanh. N\u1ebfu kh\u00f4ng, th\u1eddi gian xem l\u1ea7n cu\u1ed1i s\u1ebd \u0111\u01b0\u1ee3c l\u01b0u tr\u1eef ngay khi b\u1eaft \u0111\u1ea7u ph\u00e1t k\u00eanh.", "id": "pvrplayback.delaymarklastwatched", "label": "Delay mark last watched", "level": "expert", "maximum": 600, "minimum": 0, "parent": "", "step": 30, "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Hi\u1ec3n th\u1ecb th\u00f4ng tin ch\u1ea5t l\u01b0\u1ee3ng t\u00edn hi\u1ec7u trong c\u1eeda s\u1ed5 th\u00f4ng tin codec (n\u1ebfu \u0111\u01b0\u1ee3c h\u1ed7 tr\u1ee3 b\u1edfi ti\u1ec7n \u00edch v\u00e0 backend).", "id": "pvrplayback.signalquality", "label": "Hi\u1ec3n th\u1ecb ch\u1ea5t l\u01b0\u1ee3ng s\u00f3ng", "level": "advanced", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 0, "enabled": true, "help": "N\u1ebfu b\u1eadt, t\u1ed1c \u0111\u1ed9 khung h\u00ecnh n\u00e0y s\u1ebd \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng cho c\u00e1c lu\u1ed3ng ch\u00fang t\u00f4i kh\u00f4ng th\u1ec3 ph\u00e1t hi\u1ec7n khung h\u00ecnh/gi\u00e2y.", "id": "pvrplayback.fps", "label": "Fallback framerate", "level": "basic", "options": [{"label": "T\u1eaft", "value": 0}, {"label": "50 Hz", "value": 1}, {"label": "59.94 Hz", "value": 2}], "parent": "", "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Enable automatic playback of the next programme when playing past programmes (catchup) or for Video On Demand (VOD) channels. Please note that catchup and VOD only work if supported by the channel provider.", "id": "pvrplayback.autoplaynextprogramme", "label": "Play next programme automatically", "level": "advanced", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "D\u1eef li\u1ec7u RDS c\u00f3 th\u1ec3 \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng n\u1ebfu c\u00f3", "id": "pvrplayback.enableradiords", "label": "B\u1eadt RDS cho k\u00eanh radio", "level": "standard", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "RDS informs you about traffic advisory messages", "id": "pvrplayback.trafficadvisory", "label": "Message traffic advisory", "level": "standard", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d}.0 dB", "type": "spinner"}, "default": 10, "enabled": false, "help": "If traffic advisory is send from RDS, volume is increased", "id": "pvrplayback.trafficadvisoryvolume", "label": "Increase volume on traffic advisory", "level": "advanced", "maximum": 20, "minimum": 0, "parent": "", "step": 1, "type": "integer", "value": 10}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 0, "enabled": true, "help": "Action to perform when pressing the record button. [Record current show] will record the current show from \"now\" to the end of the show. If no TV guide data is currently available a fixed length recording starting \"now\", with the value set for \"Instant recording duration\" will be scheduled. [Record for a fixed period of time] will schedule a fixed length recording starting \"now\", with the value set for \"Instant recording duration\". [Ask what to do] will open a dialogue containing different recording actions to choose from, like \"Record current show\", \"Record next show\" and some fixed duration recordings.", "id": "pvrrecord.instantrecordaction", "label": "Instant recording action", "level": "standard", "options": [{"label": "Ghi l\u1ea1i ch\u01b0\u01a1ng tr\u00ecnh hi\u1ec7n t\u1ea1i (n\u1ebfu c\u00f3 s\u1eb5n d\u1eef li\u1ec7u l\u1ecbch ph\u00e1t s\u00f3ng)", "value": 0}, {"label": "Record for a fixed period of time (Instant recording duration)", "value": 1}, {"label": "H\u1ecfi t\u00f4i", "value": 2}], "parent": "", "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d} ph\u00fat", "type": "spinner"}, "default": 120, "enabled": true, "help": "Duration of instant recordings when pressing the record button. This value will be taken into account if \"Instant recording action\" is set to \"Record for a fixed period of time\"", "id": "pvrrecord.instantrecordtime", "label": "Th\u1eddi l\u01b0\u1ee3ng ghi \u00e2m t\u1ee9c th\u00ec", "level": "standard", "maximum": 720, "minimum": 1, "parent": "", "step": 1, "type": "integer", "value": 120}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 0, "enabled": true, "help": "Additional time to record before the scheduled start time to allow for minor broadcasting changes. Not supported by all add-ons and backends.", "id": "pvrrecord.marginstart", "label": "Default start padding time", "level": "advanced", "options": [{"label": "0 ph\u00fat", "value": 0}, {"label": "1 ph\u00fat", "value": 1}, {"label": "2 ph\u00fat", "value": 2}, {"label": "3 ph\u00fat", "value": 3}, {"label": "5 ph\u00fat", "value": 5}, {"label": "10 ph\u00fat", "value": 10}, {"label": "15 ph\u00fat", "value": 15}, {"label": "20 ph\u00fat", "value": 20}, {"label": "30 ph\u00fat", "value": 30}, {"label": "60 ph\u00fat", "value": 60}, {"label": "90 ph\u00fat", "value": 90}, {"label": "120 ph\u00fat", "value": 120}, {"label": "180 ph\u00fat", "value": 180}], "parent": "", "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 0, "enabled": true, "help": "Additional time to record after the scheduled end time to allow for minor broadcasting changes. Not supported by all add-ons and backends.", "id": "pvrrecord.marginend", "label": "Default end padding time", "level": "advanced", "options": [{"label": "0 ph\u00fat", "value": 0}, {"label": "1 ph\u00fat", "value": 1}, {"label": "2 ph\u00fat", "value": 2}, {"label": "3 ph\u00fat", "value": 3}, {"label": "5 ph\u00fat", "value": 5}, {"label": "10 ph\u00fat", "value": 10}, {"label": "15 ph\u00fat", "value": 15}, {"label": "20 ph\u00fat", "value": 20}, {"label": "30 ph\u00fat", "value": 30}, {"label": "60 ph\u00fat", "value": 60}, {"label": "90 ph\u00fat", "value": 90}, {"label": "120 ph\u00fat", "value": 120}, {"label": "180 ph\u00fat", "value": 180}], "parent": "", "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Hi\u1ec3n th\u1ecb th\u00f4ng b\u00e1o khi b\u1ed9 h\u1eb9n gi\u1edd \u0111\u01b0\u1ee3c th\u00eam, k\u1ebft th\u00fac ho\u1eb7c x\u00f3a b\u1edfi ph\u1ee5 tr\u1ee3.", "id": "pvrrecord.timernotifications", "label": "Hi\u1ec3n th\u1ecb th\u00f4ng b\u00e1o v\u1ec1 c\u1eadp nh\u1eadt h\u1eb9n gi\u1edd", "level": "advanced", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d} gi\u00e2y", "type": "spinner"}, "default": 10, "enabled": true, "help": "Choose a time in seconds after which PVR reminder popups will be automatically closed.", "id": "pvrreminders.autoclosedelay", "label": "Automatically close reminder popup after", "level": "standard", "maximum": 60, "minimum": 1, "parent": "", "step": 1, "type": "integer", "value": 10}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "If enabled, a recording for the programme to remind will be scheduled when auto-closing the reminder popup, if supported by the PVR add-on and backend.", "id": "pvrreminders.autorecord", "label": "Schedule recording when auto-closing the reminder popup", "level": "standard", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "If enabled, switch to the channel with the programme to remind when auto-closing the reminder popup.", "id": "pvrreminders.autoswitch", "label": "Switch to channel when auto-closing the reminder popup", "level": "standard", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Execute the wakeup command below when exiting this application or going into hibernation mode. The timestamp of the next scheduled recording is passed as parameter.", "id": "pvrpowermanagement.enabled", "label": "B\u1eadt", "level": "advanced", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d} ph\u00fat", "minimumlabel": "T\u1eaft", "type": "spinner"}, "default": 15, "enabled": false, "help": "The command will not be executed when a recording will be started within this timeout.", "id": "pvrpowermanagement.backendidletime", "label": "Backend idle time", "level": "advanced", "maximum": 360, "minimum": 0, "parent": "", "step": 5, "type": "integer", "value": 15}, {"allowempty": true, "allownewoption": false, "control": {"delayed": true, "format": "string", "hidden": false, "type": "edit", "verifynewvalue": false}, "default": "", "enabled": false, "help": "The command to execute (cmd [timestamp]).", "id": "pvrpowermanagement.setwakeupcmd", "label": "L\u1ec7nh \u0111\u00e1nh th\u1ee9c", "level": "advanced", "parent": "", "type": "string", "value": ""}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d} ph\u00fat", "minimumlabel": "T\u1eaft", "type": "spinner"}, "default": 15, "enabled": false, "help": "Time to subtract from the start time of the next scheduled recording.", "id": "pvrpowermanagement.prewakeup", "label": "\u0110\u00e1nh th\u1ee9c tr\u01b0\u1edbc khi ghi", "level": "advanced", "maximum": 60, "minimum": 0, "parent": "", "step": 1, "type": "integer", "value": 15}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": false, "help": "Th\u1ef1c hi\u1ec7n l\u1ec7nh \u0111\u00e1nh th\u1ee9c m\u1ed7i ng\u00e0y t\u1ea1i th\u1eddi \u0111i\u1ec3m nh\u1ea5t \u0111\u1ecbnh.", "id": "pvrpowermanagement.dailywakeup", "label": "\u0110\u00e1nh th\u1ee9c m\u1ed7i ng\u00e0y", "level": "advanced", "parent": "", "type": "boolean", "value": false}, {"allowempty": false, "allownewoption": false, "control": {"delayed": true, "format": "string", "hidden": false, "type": "edit", "verifynewvalue": false}, "default": "00:00:00", "enabled": false, "help": "When to execute the daily wakeup command.", "id": "pvrpowermanagement.dailywakeuptime", "label": "Th\u1eddi gian th\u1ee9c d\u1eady h\u00e0ng ng\u00e0y (HH:MM:SS)", "level": "advanced", "parent": "", "type": "string", "value": "00:00:00"}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Asks for a pin code to access parental locked channels. Channels can be marked as locked in the channels editor on the general tab. Parental locked channels can't be played or recorded without entering a pin code, and the guide information is hidden for those channels.", "id": "pvrparental.enabled", "label": "B\u1eadt", "level": "advanced", "parent": "", "type": "boolean", "value": false}, {"allowempty": true, "allownewoption": false, "control": {"delayed": false, "format": "integer", "hidden": true, "type": "edit", "verifynewvalue": true}, "default": "", "enabled": false, "help": "Nh\u1eadp m\u00e3 pin m\u1edbi \u0111\u1ec3 m\u1edf kh\u00f3a k\u00eanh b\u1ecb kh\u00f3a c\u1ee7a ph\u1ee5 huynh.", "id": "pvrparental.pin", "label": "\u0110\u1ed5i m\u00e3 PIN", "level": "advanced", "parent": "", "type": "string", "value": ""}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d} gi\u00e2y", "type": "spinner"}, "default": 300, "enabled": false, "help": "Ask for the pin code again when trying to access a parental locked channel and the code hasn't been asked for this duration.", "id": "pvrparental.duration", "label": "M\u1edf trong th\u1eddi gian", "level": "advanced", "maximum": 1200, "minimum": 5, "parent": "", "step": 5, "type": "integer", "value": 300}, {"allowempty": false, "allownewoption": false, "control": {"delayed": true, "format": "string", "hidden": false, "type": "edit", "verifynewvalue": false}, "default": "Kodi", "enabled": true, "help": "T\u00ean \u0111\u1ec3 hi\u1ec3n th\u1ecb cho thi\u1ebft b\u1ecb n\u00e0y khi s\u1eed d\u1ee5ng c\u00e1c d\u1ecbch v\u1ee5 m\u1ea1ng kh\u00e1c nhau.", "id": "services.devicename", "label": "T\u00ean thi\u1ebft b\u1ecb", "level": "basic", "parent": "", "type": "string", "value": "Kodi"}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Allows applications on the network to discover enabled services via Zeroconf.", "id": "services.zeroconf", "label": "Th\u00f4ng b\u00e1o d\u1ecbch v\u1ee5 cho c\u00e1c h\u1ec7 th\u1ed1ng kh\u00e1c", "level": "standard", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Cho ph\u00e9p ng\u01b0\u1eddi d\u00f9ng t\u1eeb xa \u0111i\u1ec1u khi\u1ec3n \u1ee9ng d\u1ee5ng n\u00e0y th\u00f4ng qua m\u00e1y ch\u1ee7 web \u0111\u01b0\u1ee3c t\u00edch h\u1ee3p s\u1eb5n. Kh\u00f4ng bao gi\u1edd \u0111\u1ec3 l\u1ed9 c\u1ed5ng m\u00e1y ch\u1ee7 web tr\u00ean internet.", "id": "services.webserver", "label": "Cho ph\u00e9p \u0111i\u1ec1u khi\u1ec3n t\u1eeb xa qua HTTP", "level": "standard", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": true, "format": "integer", "hidden": false, "type": "edit", "verifynewvalue": false}, "default": 8080, "enabled": true, "help": "X\u00e1c \u0111\u1ecbnh c\u1ed5ng m\u00e1y ch\u1ee7 web.", "id": "services.webserverport", "label": "C\u1ed5ng", "level": "standard", "maximum": 65535, "minimum": 1, "parent": "services.webserver", "step": 1, "type": "integer", "value": 8080}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Ch\u1ecdn xem c\u00e1c y\u00eau c\u1ea7u \u0111\u1ebfn m\u00e1y ch\u1ee7 web c\u00f3 y\u00eau c\u1ea7u t\u00ean ng\u01b0\u1eddi d\u00f9ng v\u00e0 m\u1eadt kh\u1ea9u hay kh\u00f4ng, n\u1ebfu \u0111\u01b0\u1ee3c b\u1eadt th\u00ec ph\u1ea3i \u0111\u1eb7t t\u00ean ng\u01b0\u1eddi d\u00f9ng v\u00e0 m\u1eadt kh\u1ea9u n\u00e0y. B\u1ea1n n\u00ean b\u1eadt c\u00e0i \u0111\u1eb7t n\u00e0y.", "id": "services.webserverauthentication", "label": "Y\u00eau c\u1ea7u x\u00e1c th\u1ef1c", "level": "standard", "parent": "services.webserver", "type": "boolean", "value": true}, {"allowempty": false, "allownewoption": false, "control": {"delayed": true, "format": "string", "hidden": false, "type": "edit", "verifynewvalue": false}, "default": "kodi", "enabled": true, "help": "X\u00e1c \u0111\u1ecbnh t\u00ean ng\u01b0\u1eddi d\u00f9ng m\u00e1y ch\u1ee7 web. Ph\u1ea3i \u0111\u01b0\u1ee3c \u0111\u1eb7t khi k\u00edch ho\u1ea1t x\u00e1c th\u1ef1c.", "id": "services.webserverusername", "label": "T\u00ean truy nh\u1eadp", "level": "standard", "parent": "services.webserver", "type": "string", "value": "kodi"}, {"allowempty": true, "allownewoption": false, "control": {"delayed": true, "format": "string", "hidden": true, "type": "edit", "verifynewvalue": false}, "default": "", "enabled": true, "help": "X\u00e1c \u0111\u1ecbnh m\u1eadt kh\u1ea9u m\u00e1y ch\u1ee7 web. Ph\u1ea3i \u0111\u01b0\u1ee3c \u0111\u1eb7t khi k\u00edch ho\u1ea1t x\u00e1c th\u1ef1c.", "id": "services.webserverpassword", "label": "M\u1eadt kh\u1ea9u", "level": "standard", "parent": "services.webserver", "type": "string", "value": ""}, {"addontype": "xbmc.webinterface", "allowempty": false, "allownewoption": false, "control": {"delayed": false, "format": "addon", "type": "button"}, "default": "webinterface.default", "enabled": true, "help": "Ch\u1ecdn gi\u1eefa c\u00e1c giao di\u1ec7n web \u0111\u01b0\u1ee3c c\u00e0i \u0111\u1eb7t th\u00f4ng qua tr\u00ecnh qu\u1ea3n l\u00fd b\u1ed5 tr\u1ee3.", "id": "services.webskin", "label": "Giao di\u1ec7n web", "level": "standard", "parent": "", "type": "addon", "value": "webinterface.default"}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Cho ph\u00e9p c\u00e1c ch\u01b0\u01a1ng tr\u00ecnh tr\u00ean thi\u1ebft b\u1ecb n\u00e0y \u0111i\u1ec1u khi\u1ec3n \u1ee9ng d\u1ee5ng b\u1eb1ng JSON-RPC qua WebSocket, JSON-RPC qua TCP ho\u1eb7c giao th\u1ee9c EventServer m\u00e0 kh\u00f4ng c\u1ea7n x\u00e1c th\u1ef1c.", "id": "services.esenabled", "label": "Cho ph\u00e9p \u0111i\u1ec1u khi\u1ec3n t\u1eeb xa t\u1eeb \u1ee9ng d\u1ee5ng tr\u00ean h\u1ec7 th\u1ed1ng n\u00e0y", "level": "standard", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Cho ph\u00e9p c\u00e1c ch\u01b0\u01a1ng tr\u00ecnh tr\u00ean m\u1ea1ng \u0111i\u1ec1u khi\u1ec3n \u1ee9ng d\u1ee5ng b\u1eb1ng JSON-RPC qua WebSocket, JSON-RPC qua TCP ho\u1eb7c giao th\u1ee9c EventServer m\u00e0 kh\u00f4ng c\u1ea7n x\u00e1c th\u1ef1c. N\u00f3 cho ph\u00e9p b\u1ea5t k\u1ef3 ai c\u00f3 quy\u1ec1n truy c\u1eadp v\u00e0o m\u1ea1ng \u0111\u1ec1u c\u00f3 th\u1ec3 ki\u1ec3m so\u00e1t \u1ee9ng d\u1ee5ng n\u00e0y v\u00e0 do \u0111\u00f3, thi\u1ebft b\u1ecb n\u00e0y. Kh\u00f4ng n\u00ean \u0111\u1ec3 l\u1ed9 giao di\u1ec7n n\u00e0y tr\u00ean internet.", "id": "services.esallinterfaces", "label": "Cho ph\u00e9p \u0111i\u1ec1u khi\u1ec3n t\u1eeb xa t\u1eeb \u1ee9ng d\u1ee5ng tr\u00ean c\u00e1c h\u1ec7 th\u1ed1ng kh\u00e1c", "level": "standard", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Cho ph\u00e9p UPnP. \u0110i\u1ec1u n\u00e0y cho ph\u00e9p b\u1ea1n truy\u1ec1n ph\u00e1t ph\u01b0\u01a1ng ti\u1ec7n trong th\u01b0 vi\u1ec7n c\u1ee7a m\u00ecnh \u0111\u1ebfn m\u00e1y kh\u00e1ch UPnP v\u00e0 ph\u00e1t hi\u1ec7n m\u00e1y ch\u1ee7 UPnP t\u1eeb xa.", "id": "services.upnp", "label": "B\u1eadt h\u1ed7 tr\u1ee3 UPnP", "level": "basic", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": false, "help": "Cho ph\u00e9p m\u00e1y ch\u1ee7 UPnP. \u0110i\u1ec1u n\u00e0y cho ph\u00e9p b\u1ea1n truy\u1ec1n ph\u00e1t ph\u01b0\u01a1ng ti\u1ec7n trong th\u01b0 vi\u1ec7n c\u1ee7a m\u00ecnh \u0111\u1ebfn m\u00e1y kh\u00e1ch UPnP.", "id": "services.upnpserver", "label": "Chia s\u1ebb th\u01b0 vi\u1ec7n c\u1ee7a t\u00f4i", "level": "basic", "parent": "services.upnp", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": false, "help": "Khi c\u1eadp nh\u1eadt th\u01b0 vi\u1ec7n th\u1ee7 c\u00f4ng ho\u1eb7c t\u1ef1 \u0111\u1ed9ng x\u1ea3y ra, th\u00f4ng b\u00e1o cho m\u00e1y kh\u00e1ch UPnP.", "id": "services.upnpannounce", "label": "Th\u00f4ng b\u00e1o c\u1eadp nh\u1eadt th\u01b0 vi\u1ec7n", "level": "advanced", "parent": "services.upnpserver", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": false, "help": "T\u00ecm ph\u1ee5 \u0111\u1ec1 b\u00ean ngo\u00e0i cho c\u00e1c video \u0111\u01b0\u1ee3c cung c\u1ea5p b\u1edfi m\u00e1y ch\u1ee7 UPnP. \u0110i\u1ec1u n\u00e0y c\u00f3 th\u1ec3 g\u00e2y ra m\u1edf r\u1ed9ng CPU, h\u1ec7 th\u1ed1ng t\u1eadp tin v\u00e0 t\u1ed1c \u0111\u1ed9 m\u1ea1ng.", "id": "services.upnplookforexternalsubtitles", "label": "T\u00ecm ph\u1ee5 \u0111\u1ec1 b\u00ean ngo\u00e0i", "level": "advanced", "parent": "services.upnpserver", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": false, "help": "B\u1eadt \u0111i\u1ec3m \u0111i\u1ec1u khi\u1ec3n UPnP. \u0110i\u1ec1u n\u00e0y cho ph\u00e9p b\u1ea1n truy\u1ec1n ph\u00e1t ph\u01b0\u01a1ng ti\u1ec7n \u0111\u1ebfn b\u1ea5t k\u1ef3 m\u00e1y kh\u00e1ch UPnP n\u00e0o v\u00e0 \u0111i\u1ec1u khi\u1ec3n ph\u00e1t n\u00f3.", "id": "services.upnpcontroller", "label": "T\u00ecm tr\u00ecnh ch\u01a1i UPnP t\u1eeb xa", "level": "advanced", "parent": "services.upnpserver", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": false, "help": "If selected the remote player volume level will be synchronized with the volume of this application.[CR]Warning: Global system volume level may be different than the application volume level - they are controlled independently.[CR]This may lead the remote player to be set to 100% volume level if the application has 100% volume level but the overall system volume level is smaller.", "id": "services.upnpplayervolumesync", "label": "Synchronize volume level to remote UPnP players", "level": "advanced", "parent": "services.upnpserver", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": false, "help": "K\u00edch ho\u1ea1t \u1ee9ng d\u1ee5ng kh\u00e1ch UPnP. \u0110i\u1ec1u n\u00e0y cho ph\u00e9p b\u1ea1n truy\u1ec1n ph\u00e1t ph\u01b0\u01a1ng ti\u1ec7n t\u1eeb b\u1ea5t k\u1ef3 m\u00e1y ch\u1ee7 UPnP n\u00e0o v\u1edbi \u0111i\u1ec3m ki\u1ec3m so\u00e1t v\u00e0 \u0111i\u1ec1u khi\u1ec3n ph\u00e1t t\u1eeb m\u00e1y ch\u1ee7 \u0111\u00f3.", "id": "services.upnprenderer", "label": "Cho ph\u00e9p \u0111i\u1ec1u khi\u1ec3n t\u1eeb xa th\u00f4ng qua UPnP", "level": "standard", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "N\u1ebfu b\u1eadt, c\u00f3 th\u1ec3 nh\u1eadn \u0111\u01b0\u1ee3c n\u1ed9i dung t\u1eeb c\u00e1c thi\u1ebft b\u1ecb ho\u1eb7c \u1ee9ng d\u1ee5ng AirPlay kh\u00e1c.", "id": "services.airplay", "label": "B\u1eadt h\u1ed7 tr\u1ee3 AirPlay", "level": "standard", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": false, "help": "Cho ph\u00e9p \u0111i\u1ec1u khi\u1ec3n \u00e2m l\u01b0\u1ee3ng t\u1eeb m\u00e1y kh\u00e1ch AirPlay.", "id": "services.airplayvolumecontrol", "label": "Cho ph\u00e9p \u0111i\u1ec1u khi\u1ec3n \u00e2m l\u01b0\u1ee3ng", "level": "advanced", "parent": "services.airplay", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": false, "help": "B\u1eadt h\u1ed7 tr\u1ee3 \u0111\u1ec3 nh\u1eadn \"Video\" v\u00e0 \"H\u00ecnh \u1ea3nh\" qua AirPlay. \u0110i\u1ec1u n\u00e0y c\u1ea7n ph\u1ea3i \u0111\u01b0\u1ee3c v\u00f4 hi\u1ec7u h\u00f3a khi s\u1eed d\u1ee5ng m\u00e1y kh\u00e1ch iOS 9 tr\u1edf l\u00ean \u0111\u1ec3 kh\u00f4i ph\u1ee5c ph\u00e1t nh\u1ea1c qua AirPlay. \"Video\" v\u00e0 \"H\u00ecnh \u1ea3nh\" ch\u1ec9 \u0111\u01b0\u1ee3c h\u1ed7 tr\u1ee3 cho kh\u00e1ch h\u00e0ng iOS s\u1eed d\u1ee5ng iOS 8.x tr\u1edf l\u00ean.", "id": "services.airplayvideosupport", "label": "B\u1eadt h\u1ed7 tr\u1ee3 \"Video\" v\u00e0 \"H\u00ecnh \u1ea3nh\" c\u1ee7a AirPlay", "level": "expert", "parent": "services.airplay", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": false, "help": "B\u1eadt m\u1eadt kh\u1ea9u b\u1ea3o v\u1ec7 AirPlay.", "id": "services.useairplaypassword", "label": "S\u1eed d\u1ee5ng m\u1eadt kh\u1ea9u b\u1ea3o v\u1ec7", "level": "standard", "parent": "services.airplayvideosupport", "type": "boolean", "value": false}, {"allowempty": true, "allownewoption": false, "control": {"delayed": true, "format": "string", "hidden": true, "type": "edit", "verifynewvalue": false}, "default": "", "enabled": false, "help": "\u0110\u1eb7t m\u1eadt kh\u1ea9u AirPlay.", "id": "services.airplaypassword", "label": "M\u1eadt kh\u1ea9u", "level": "standard", "parent": "services.useairplaypassword", "type": "string", "value": ""}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Enable service to search for SMB services using the WS-Discovery protocol", "id": "services.wsdiscovery", "label": "Enable WS-Discovery Service", "level": "advanced", "parent": "", "type": "boolean", 