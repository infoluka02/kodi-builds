arent": "", "step": 1, "type": "integer", "value": 3}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": true, "help": "Hi\u1ec7u ch\u1ec9nh giao di\u1ec7n ng\u01b0\u1eddi d\u00f9ng b\u1eb1ng c\u00e1ch \u0111i\u1ec1u ch\u1ec9nh qu\u00e9t qu\u00e1 m\u1ee9c. S\u1eed d\u1ee5ng c\u00f4ng c\u1ee5 n\u00e0y n\u1ebfu h\u00ecnh \u1ea3nh \u0111\u01b0\u1ee3c hi\u1ec3n th\u1ecb qu\u00e1 l\u1edbn ho\u1eb7c qu\u00e1 nh\u1ecf so v\u1edbi m\u00e0n h\u00ecnh c\u1ee7a b\u1ea1n.", "id": "videoscreen.guicalibration", "label": "Hi\u1ec7u chu\u1ea9n video", "level": "expert", "parent": "", "type": "action"}, {"allowempty": false, "allownewoption": false, "control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": "DIRECTSOUND:default", "enabled": true, "help": "Ch\u1ecdn thi\u1ebft b\u1ecb \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng \u0111\u1ec3 ph\u00e1t \u00e2m thanh \u0111\u00e3 \u0111\u01b0\u1ee3c gi\u1ea3i m\u00e3, ch\u1eb3ng h\u1ea1n nh\u01b0 mp3.", "id": "audiooutput.audiodevice", "label": "Thi\u1ebft b\u1ecb \u00e2m thanh \u0111\u1ea7u ra", "level": "basic", "options": [{"label": "DIRECTSOUND: Speakers - Speakers (Realtek(R) Audio), DIRECTSOUND: Speakers (Realtek(R) Audio)", "value": "DIRECTSOUND:{38515F33-BD2F-4F1B-ACB5-DE2070BAC20D}|Speakers - Speakers (Realtek(R) Audio)"}, {"label": "DIRECTSOUND: default", "value": "DIRECTSOUND:default"}, {"label": "DIRECTSOUND: HDMI - ZOWIE XL LCD (NVIDIA High Definition Audio), DIRECTSOUND: ZOWIE XL LCD (NVIDIA High Definition Audio)", "value": "DIRECTSOUND:{E07493D3-94B9-4C05-94ED-B91887BADFBA}|HDMI - ZOWIE XL LCD (NVIDIA High Definition Audio)"}, {"label": "WASAPI: Speakers - Speakers (Realtek(R) Audio), WASAPI: Speakers (Realtek(R) Audio)", "value": "WASAPI:{38515F33-BD2F-4F1B-ACB5-DE2070BAC20D}|Speakers - Speakers (Realtek(R) Audio)"}, {"label": "WASAPI: default", "value": "WASAPI:default"}, {"label": "WASAPI: HDMI - ZOWIE XL LCD (NVIDIA High Definition Audio), WASAPI: ZOWIE XL LCD (NVIDIA High Definition Audio)", "value": "WASAPI:{E07493D3-94B9-4C05-94ED-B91887BADFBA}|HDMI - ZOWIE XL LCD (NVIDIA High Definition Audio)"}], "parent": "", "type": "string", "value": "DIRECTSOUND:default"}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 1, "enabled": true, "help": "Ch\u1ecdn s\u1ed1 l\u01b0\u1ee3ng k\u00eanh \u0111\u01b0\u1ee3c h\u1ed7 tr\u1ee3 b\u1edfi k\u1ebft n\u1ed1i \u00e2m thanh ho\u1eb7c s\u1ed1 l\u01b0\u1ee3ng loa n\u1ebfu \u0111\u01b0\u1ee3c k\u1ebft n\u1ed1i b\u1eb1ng k\u1ebft n\u1ed1i t\u01b0\u01a1ng t\u1ef1. C\u00e0i \u0111\u1eb7t n\u00e0y kh\u00f4ng \u00e1p d\u1ee5ng cho \u00e2m thanh passthrough. L\u01b0u \u00fd: S/PDIF ch\u1ec9 h\u1ed7 tr\u1ee3 k\u00eanh 2.0 nh\u01b0ng v\u1eabn c\u00f3 th\u1ec3 xu\u1ea5t \u00e2m thanh \u0111a k\u00eanh b\u1eb1ng \u0111\u1ecbnh d\u1ea1ng \u0111\u01b0\u1ee3c h\u1ed7 tr\u1ee3 b\u1edfi passthrough.", "id": "audiooutput.channels", "label": "S\u1ed1 l\u01b0\u1ee3ng k\u00eanh", "level": "basic", "options": [{"label": "2.0", "value": 1}, {"label": "2.1", "value": 2}, {"label": "3.0", "value": 3}, {"label": "3.1", "value": 4}, {"label": "4.0", "value": 5}, {"label": "4.1", "value": 6}, {"label": "5.0", "value": 7}, {"label": "5.1", "value": 8}, {"label": "7.0", "value": 9}, {"label": "7.1", "value": 10}], "parent": "", "type": "integer", "value": 1}, {"control": {"delayed": false, "format": "integer", "multiselect": false, "type": "list"}, "default": 2, "enabled": true, "help": "Ch\u1ecdn c\u00e1ch \u0111\u1eb7t thu\u1ed9c t\u00ednh c\u1ee7a \u0111\u1ea7u ra \u00e2m thanh: [Ch\u1ec9nh s\u1eeda] Thu\u1ed9c t\u00ednh \u0111\u1ea7u ra \u0111\u01b0\u1ee3c \u0111\u1eb7t th\u00e0nh t\u1ed1c \u0111\u1ed9 l\u1ea5y m\u1eabu & c\u1ea5u h\u00ecnh loa \u0111\u01b0\u1ee3c ch\u1ec9 \u0111\u1ecbnh m\u1ecdi l\u00fac; [K\u1ebft h\u1ee3p t\u1ed1t nh\u1ea5t] Thu\u1ed9c t\u00ednh \u0111\u1ea7u ra \u0111\u01b0\u1ee3c \u0111\u1eb7t \u0111\u1ec3 lu\u00f4n kh\u1edbp v\u1edbi thu\u1ed9c t\u00ednh ngu\u1ed3n nh\u1ea5t c\u00f3 th\u1ec3; [T\u1ed1i \u01b0u h\u00f3a] Thu\u1ed9c t\u00ednh \u0111\u1ea7u ra \u0111\u01b0\u1ee3c \u0111\u1eb7t khi b\u1eaft \u0111\u1ea7u ph\u00e1t v\u00e0 s\u1ebd kh\u00f4ng thay \u0111\u1ed5i n\u1ebfu thu\u1ed9c t\u00ednh c\u1ee7a ngu\u1ed3n thay \u0111\u1ed5i.", "id": "audiooutput.config", "label": "C\u1ea5u h\u00ecnh \u0111\u1ea7u ra", "level": "advanced", "options": [{"label": "Ch\u1ec9nh s\u1eeda", "value": 1}, {"label": "T\u1ed1i \u01b0u h\u00f3a", "value": 2}, {"label": "Ph\u00f9 h\u1ee3p nh\u1ea5t", "value": 3}], "parent": "", "type": "integer", "value": 2}, {"control": {"delayed": false, "format": "integer", "multiselect": false, "type": "list"}, "default": 90, "enabled": true, "help": "\u0110\u1eb7t s\u1ed1 l\u01b0\u1ee3ng m\u1ee9c \u0111i\u1ec1u khi\u1ec3n \u00e2m l\u01b0\u1ee3ng.", "id": "audiooutput.volumesteps", "label": "S\u1ed1 m\u1ee9c \u0111i\u1ec1u ch\u1ec9nh \u00e2m l\u01b0\u1ee3ng", "level": "standard", "maximum": 90, "minimum": 10, "parent": "", "step": 5, "type": "integer", "value": 90}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Ch\u1ecdn c\u00e1ch \u00e2m thanh \u0111\u01b0\u1ee3c downmix, v\u00ed d\u1ee5: t\u1eeb 5.1 xu\u1ed1ng 2.0.[CR][B\u1eadt] Duy tr\u00ec m\u1ee9c \u00e2m l\u01b0\u1ee3ng c\u1ee7a ngu\u1ed3n \u00e2m thanh g\u1ed1c tuy nhi\u00ean d\u1ea3i \u0111\u1ed9ng \u0111\u01b0\u1ee3c n\u00e9n.[CR][T\u1eaft] Duy tr\u00ec d\u1ea3i \u0111\u1ed9ng c\u1ee7a ngu\u1ed3n \u00e2m thanh g\u1ed1c khi downmix tuy nhi\u00ean \u00e2m l\u01b0\u1ee3ng s\u1ebd th\u1ea5p h\u01a1n. L\u01b0u \u00fd: D\u1ea3i \u0111\u1ed9ng l\u00e0 s\u1ef1 kh\u00e1c bi\u1ec7t gi\u1eefa \u00e2m thanh nh\u1ecf nh\u1ea5t v\u00e0 \u00e2m thanh l\u1edbn nh\u1ea5t trong ngu\u1ed3n \u00e2m thanh. B\u1eadt c\u00e0i \u0111\u1eb7t n\u00e0y n\u1ebfu c\u00e1c cu\u1ed9c \u0111\u1ed1i tho\u1ea1i trong phim kh\u00f4ng nghe th\u1ea5y \u0111\u01b0\u1ee3c.", "id": "audiooutput.maintainoriginalvolume", "label": "Duy tr\u00ec \u00e2m l\u01b0\u1ee3ng g\u1ed1c khi downmix", "level": "advanced", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Ch\u1ecdn \u0111\u1ec3 b\u1eadt k\u1ebft h\u1ee3p \u00e2m thanh 2 k\u00eanh v\u1edbi s\u1ed1 l\u01b0\u1ee3ng k\u00eanh \u00e2m thanh \u0111\u01b0\u1ee3c ch\u1ec9 \u0111\u1ecbnh b\u1edfi c\u1ea5u h\u00ecnh k\u00eanh.", "id": "audiooutput.stereoupmix", "label": "Stereo upmix", "level": "advanced", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 30, "enabled": true, "help": "Ch\u1ecdn ch\u1ea5t l\u01b0\u1ee3ng l\u1ea5y m\u1eabu l\u1ea1i cho tr\u01b0\u1eddng h\u1ee3p \u0111\u1ea7u ra \u00e2m thanh c\u1ea7n t\u1ed1c \u0111\u1ed9 l\u1ea5y m\u1eabu kh\u00e1c v\u1edbi t\u1ed1c \u0111\u1ed9 l\u1ea5y m\u1eabu \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng b\u1edfi ngu\u1ed3n.[CR][Th\u1ea5p] T\u1ed1c \u0111\u1ed9 nhanh v\u00e0 s\u1ebd c\u00f3 t\u00e1c \u0111\u1ed9ng t\u1ed1i thi\u1ec3u \u0111\u1ebfn t\u00e0i nguy\u00ean h\u1ec7 th\u1ed1ng nh\u01b0 s\u1eed d\u1ee5ng CPU.[CR][Trung b\u00ecnh] & [Cao] S\u1ebd s\u1eed d\u1ee5ng d\u1ea7n d\u1ea7n nhi\u1ec1u t\u00e0i nguy\u00ean h\u1ec7 th\u1ed1ng h\u01a1n.", "id": "audiooutput.processquality", "label": "Ch\u1ea5t l\u01b0\u1ee3ng l\u1ea5y m\u1eabu l\u1ea1i", "level": "advanced", "options": [{"label": "Th\u1ea5p (nhanh)", "value": 20}, {"label": "Trung b\u00ecnh", "value": 30}, {"label": "Cao", "value": 50}], "parent": "", "type": "integer", "value": 30}, {"control": {"delayed": true, "format": "integer", "hidden": false, "type": "edit", "verifynewvalue": false}, "default": 2, "enabled": true, "help": "When the speed change exceeds this threshold, a pitch-correction filter will be applied. This avoids the \"chipmonk voices\" that normally result from speeding up a video", "id": "audiooutput.atempothreshold", "label": "Threshold for pitch correction", "level": "expert", "maximum": 100, "minimum": 0, "parent": "", "step": 1, "type": "integer", "value": 2}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 1, "enabled": true, "help": "Select the behaviour when no sound is required for either playback or GUI sounds.[CR][Always] Continuous inaudible signal is output, this keeps the receiving audio device alive for any new sounds, however this might also block sound from other applications.[CR][1-10 Minutes] Same as [Always] except that after the selected period of time audio enters a suspended state.[CR][Off] Audio output enters a suspended state. Note: Sounds can be missed if audio enters suspended state.", "id": "audiooutput.streamsilence", "label": "Gi\u1eef thi\u1ebft b\u1ecb \u00e2m thanh ho\u1ea1t \u0111\u1ed9ng", "level": "advanced", "options": [{"label": "Lu\u00f4n lu\u00f4n", "value": 153722867}, {"label": "T\u1eaft", "value": 0}, {"label": "1 Ph\u00fat", "value": 1}, {"label": "2 Ph\u00fat", "value": 2}, {"label": "3 Ph\u00fat", "value": 3}, {"label": "4 Ph\u00fat", "value": 4}, {"label": "5 Ph\u00fat", "value": 5}, {"label": "6 Ph\u00fat", "value": 6}, {"label": "7 Ph\u00fat", "value": 7}, {"label": "8 Ph\u00fat", "value": 8}, {"label": "9 Ph\u00fat", "value": 9}, {"label": "10 Ph\u00fat", "value": 10}], "parent": "", "type": "integer", "value": 1}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "To keep certain AVRs powered we send an inaudible random noise signal. You can disable this setting if you are using headphone or analog output.", "id": "audiooutput.streamnoise", "label": "Send low volume noise", "level": "advanced", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 1, "enabled": true, "help": "\u0110\u1ecbnh c\u1ea5u h\u00ecnh \u00e2m thanh giao di\u1ec7n, nh\u01b0 khi \u0111i\u1ec1u h\u01b0\u1edbng menu v\u00e0 khi c\u00f3 th\u00f4ng b\u00e1o quan tr\u1ecdng.", "id": "audiooutput.guisoundmode", "label": "Ph\u00e1t \u00e2m thanh giao di\u1ec7n", "level": "basic", "options": [{"label": "Ch\u1ec9 khi ng\u1eebng ph\u00e1t", "value": 1}, {"label": "Lu\u00f4n lu\u00f4n", "value": 2}, {"label": "Kh\u00f4ng bao gi\u1edd", "value": 0}], "parent": "", "type": "integer", "value": 1}, {"control": {"delayed": false, "format": "percentage", "formatlabel": "{} %", "popup": false, "type": "slider"}, "default": 100, "enabled": true, "help": "Relative volume for gui sounds", "id": "audiooutput.guisoundvolume", "label": "\u00c2m l\u01b0\u1ee3ng", "level": "standard", "maximum": 0, "minimum": 0, "parent": "", "step": 1, "type": "integer", "value": 100}, {"addontype": "kodi.resource.uisounds", "allowempty": true, "allownewoption": false, "control": {"delayed": false, "format": "addon", "type": "button"}, "default": "resource.uisounds.kodi", "enabled": true, "help": "Ch\u1ecdn ho\u1eb7c t\u1eaft \u00e2m thanh \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng trong giao di\u1ec7n ng\u01b0\u1eddi d\u00f9ng.", "id": "lookandfeel.soundskin", "label": "\u00c2m thanh giao di\u1ec7n", "level": "basic", "parent": "", "type": "addon", "value": "resource.uisounds.kodi"}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Ch\u1ecdn s\u1ebd cho ph\u00e9p \u00e2m thanh passthrough \u0111\u1ec3 ph\u00e1t \u00e2m thanh n\u00e9n nh\u01b0 Dolby Digital (AC3), DTS, v.v. M\u00e1y kh\u00e1ch c\u1ee7a AudioEngine, v\u00ed d\u1ee5 Videoplayer, c\u00f3 th\u1ec3 quy\u1ebft \u0111\u1ecbnh gi\u1ea3i m\u00e3 lu\u1ed3ng \u00e2m thanh trong m\u1ed9t s\u1ed1 \u0111i\u1ec1u ki\u1ec7n nh\u1ea5t \u0111\u1ecbnh. Trong tr\u01b0\u1eddng h\u1ee3p Videoplayer, passthrough s\u1ebd kh\u00f4ng \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng cho lu\u1ed3ng tr\u1ef1c ti\u1ebfp v\u00e0 khi b\u1ea1n \u0111\u1ed3ng b\u1ed9 h\u00f3a ph\u00e1t \u0111\u1ec3 hi\u1ec3n th\u1ecb.", "id": "audiooutput.passthrough", "label": "Cho ph\u00e9p passthrough", "level": "standard", "parent": "", "type": "boolean", "value": false}, {"allowempty": false, "allownewoption": false, "control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": "DIRECTSOUND:default", "enabled": false, "help": "Ch\u1ecdn thi\u1ebft b\u1ecb \u0111\u01b0\u1ee3c d\u00f9ng cho ph\u00e1t l\u1ea1i c\u00e1c \u0111\u1ecbnh d\u1ea1ng \u0111\u00e3 m\u00e3 h\u00f3a, d\u01b0\u1edbi \u0111\u00e2y l\u00e0 c\u00e1c \u0111\u1ecbnh d\u1ea1ng trong kh\u1ea3 n\u0103ng h\u1ed7 tr\u1ee3 c\u1ee7a b\u1ed9 thu.", "id": "audiooutput.passthroughdevice", "label": "Thi\u1ebft b\u1ecb \u0111\u1ea7u ra passthrough", "level": "standard", "options": [{"label": "DIRECTSOUND: HDMI - ZOWIE XL LCD (NVIDIA High Definition Audio), DIRECTSOUND: ZOWIE XL LCD (NVIDIA High Definition Audio)", "value": "DIRECTSOUND:{E07493D3-94B9-4C05-94ED-B91887BADFBA}|HDMI - ZOWIE XL LCD (NVIDIA High Definition Audio)"}, {"label": "WASAPI: HDMI - ZOWIE XL LCD (NVIDIA High Definition Audio), WASAPI: ZOWIE XL LCD (NVIDIA High Definition Audio)", "value": "WASAPI:{E07493D3-94B9-4C05-94ED-B91887BADFBA}|HDMI - ZOWIE XL LCD (NVIDIA High Definition Audio)"}], "parent": "", "type": "string", "value": "DIRECTSOUND:{E07493D3-94B9-4C05-94ED-B91887BADFBA}|HDMI - ZOWIE XL LCD (NVIDIA High Definition Audio)"}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": false, "help": "Ch\u1ecdn t\u00f9y ch\u1ecdn n\u00e0y n\u1ebfu m\u00e1y thu c\u1ee7a b\u1ea1n c\u00f3 kh\u1ea3 n\u0103ng gi\u1ea3i m\u00e3 lu\u1ed3ng Dolby Digital (AC3).", "id": "audiooutput.ac3passthrough", "label": "\u0110\u1ea7u thu h\u1ed7 tr\u1ee3 Dolby Digital (AC3)", "level": "advanced", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": false, "help": "Select this if the audio out connection only supports multichannel audio as Dolby Digital 5.1 (AC-3), such as a S/PDIF connection. If your system supports PCM multichannel audio via HDMI, leave this disabled.", "id": "audiooutput.ac3transcode", "label": "K\u00edch ho\u1ea1t chuy\u1ec3n m\u00e3 Dolby Digital (AC3)", "level": "advanced", "parent": "audiooutput.ac3passthrough", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": false, "help": "Ch\u1ecdn t\u00f9y ch\u1ecdn n\u00e0y n\u1ebfu m\u00e1y thu c\u1ee7a b\u1ea1n c\u00f3 kh\u1ea3 n\u0103ng gi\u1ea3i m\u00e3 lu\u1ed3ng DTS.", "id": "audiooutput.dtspassthrough", "label": "\u0110\u1ea7u thu h\u1ed7 tr\u1ee3 DTS", "level": "advanced", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": true, "help": "C\u1ea5u h\u00ecnh b\u1ea5t k\u1ef3 thi\u1ebft b\u1ecb ngo\u1ea1i vi \u0111\u00ednh k\u00e8m.", "id": "input.peripherals", "label": "Ngo\u1ea1i vi", "level": "standard", "parent": "", "type": "action"}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": true, "help": "Xem v\u00e0 c\u1ea5u h\u00ecnh c\u00e1c ti\u1ec7n \u00edch ngo\u1ea1i vi.", "id": "input.peripherallibraries", "label": "C\u00e0i \u0111\u1eb7t tr\u00ecnh \u0111i\u1ec1u khi\u1ec3n", "level": "standard", "parent": "", "type": "action"}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "S\u1eed d\u1ee5ng chu\u1ed9t ho\u1eb7c thi\u1ebft b\u1ecb m\u00e0n h\u00ecnh c\u1ea3m \u1ee9ng \u0111\u1ec3 \u0111i\u1ec1u khi\u1ec3n giao di\u1ec7n. L\u01b0u \u00fd: T\u1eaft n\u00f3 s\u1ebd khi\u1ebfn b\u1ea1n m\u1ea5t quy\u1ec1n ki\u1ec3m so\u00e1t \u1ee9ng d\u1ee5ng n\u00e0y khi kh\u00f4ng c\u00f3 b\u00e0n ph\u00edm ho\u1eb7c \u0111i\u1ec1u khi\u1ec3n t\u1eeb xa.", "id": "input.enablemouse", "label": "B\u1eadt h\u1ed7 tr\u1ee3 chu\u1ed9t v\u00e0 m\u00e0n h\u00ecnh c\u1ea3m \u1ee9ng", "level": "advanced", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "S\u1eed d\u1ee5ng b\u1ed9 \u0111i\u1ec1u khi\u1ec3n tr\u00f2 ch\u01a1i \u0111\u1ec3 \u0111i\u1ec1u khi\u1ec3n giao di\u1ec7n.", "id": "input.enablejoystick", "label": "B\u1eadt h\u1ed7 tr\u1ee3 b\u1ed9 \u0111i\u1ec1u khi\u1ec3n", "level": "advanced", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": true, "help": "Gh\u00e9p n\u1ed1i b\u1ed9 \u0111i\u1ec1u khi\u1ec3n c\u1ee7a b\u1ea1n v\u1edbi thi\u1ebft b\u1ecb \u0111\u1ea7u v\u00e0o kh\u00e1c nhau c\u1ee7a h\u1ec7 th\u1ed1ng tr\u00f2 ch\u01a1i kh\u00e1c nhau.", "id": "input.controllerconfig", "label": "C\u1ea5u h\u00ecnh b\u1ed9 \u0111i\u1ec1u khi\u1ec3n \u0111\u00ednh k\u00e8m", "level": "basic", "parent": "", "type": "action"}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "N\u1ebfu k\u1ebft n\u1ed1i internet c\u1ee7a b\u1ea1n s\u1eed d\u1ee5ng m\u00e1y ch\u1ee7 proxy, h\u00e3y \u0111\u1ecbnh c\u1ea5u h\u00ecnh t\u1ea1i \u0111\u00e2y.", "id": "network.usehttpproxy", "label": "D\u00f9ng m\u00e1y ch\u1ee7 proxy", "level": "standard", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 0, "enabled": false, "help": "C\u1ea5u h\u00ecnh lo\u1ea1i proxy \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng.", "id": "network.httpproxytype", "label": "Ki\u1ec3u proxy", "level": "standard", "options": [{"label": "HTTP", "value": 0}, {"label": "HTTPS", "value": 5}, {"label": "SOCKS4", "value": 1}, {"label": "SOCKS4A", "value": 2}, {"label": "SOC